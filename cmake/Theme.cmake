include_guard(GLOBAL)

function(_braurser_theme_object json label)
    string(JSON type TYPE "${json}")
    if(NOT type STREQUAL "OBJECT")
        message(FATAL_ERROR "${label} must be an object")
    endif()
    string(JSON count LENGTH "${json}")
    list(LENGTH ARGN expected_count)
    if(NOT count EQUAL expected_count)
        message(FATAL_ERROR "${label} has unexpected or missing keys")
    endif()
    foreach(key IN LISTS ARGN)
        string(JSON value ERROR_VARIABLE error TYPE "${json}" "${key}")
        if(error)
            message(FATAL_ERROR "${label} is missing ${key}")
        endif()
    endforeach()
endfunction()

function(_braurser_theme_read path output)
    file(SIZE "${path}" length)
    if(length GREATER 131072)
        message(FATAL_ERROR "Theme input exceeds 128 KiB: ${path}")
    endif()
    file(READ "${path}" content)
    set("${output}" "${content}" PARENT_SCOPE)
endfunction()

function(_braurser_theme_render body output)
    set(rendered "${body}")
    string(REGEX MATCHALL "\\$\\{[^}]*\\}" placeholders "${body}")
    foreach(placeholder IN LISTS placeholders)
        string(LENGTH "${placeholder}" length)
        math(EXPR length "${length} - 3")
        string(SUBSTRING "${placeholder}" 2 ${length} key)
        if(NOT key IN_LIST allowed_substitutions)
            message(FATAL_ERROR "Unknown theme placeholder: ${placeholder}")
        endif()
        string(REPLACE "${placeholder}" "${${key}}" rendered "${rendered}")
    endforeach()
    if("${body}" MATCHES "@[A-Za-z_][A-Za-z0-9_]*@")
        message(FATAL_ERROR "Theme templates must use dollar-brace substitutions")
    endif()
    if("${rendered}" MATCHES "\\$\\{|@[A-Za-z_][A-Za-z0-9_]*@")
        message(FATAL_ERROR "Unresolved theme placeholder")
    endif()
    set("${output}" "${rendered}" PARENT_SCOPE)
endfunction()

function(braurser_generate_theme)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "OUTPUT_DIR" "")
    if(NOT arg_OUTPUT_DIR OR arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "braurser_generate_theme requires OUTPUT_DIR <dir>")
    endif()
    set(data_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../data")
    _braurser_theme_read("${data_dir}/tokens.json" tokens)
    _braurser_theme_object("${tokens}" "tokens" version color size font motion)
    string(JSON version_type TYPE "${tokens}" version)
    string(JSON version GET "${tokens}" version)
    if(NOT version_type STREQUAL "NUMBER" OR NOT version STREQUAL "1")
        message(FATAL_ERROR "Unsupported theme token version")
    endif()
    set(colors
        br_bg br_surface br_subtle br_hover br_pressed br_text br_muted br_line
        br_separator br_accent br_accent_hover br_accent_pressed br_on_accent
        br_selected br_on_selected br_success br_success_bg br_warning
        br_warning_bg br_error br_error_bg br_info br_info_bg)
    string(JSON color_object GET "${tokens}" color)
    _braurser_theme_object("${color_object}" "color" ${colors})
    list(LENGTH colors color_count)
    set(header "#pragma once\n\n#include <array>\n#include <cstdint>\n#include <string_view>\n\nnamespace braurser::theme {\n\nstruct ColorToken {\n    std::string_view name;\n    std::uint32_t light;\n    std::uint32_t dark;\n};\n\ninline constexpr std::array<ColorToken, ${color_count}> kColors{{\n")
    set(allowed_substitutions ${colors})
    set(reserved_identifiers "")
    foreach(key IN LISTS colors)
        string(JSON color GET "${color_object}" "${key}")
        _braurser_theme_object("${color}" "color.${key}" light dark)
        foreach(mode IN ITEMS light dark)
            string(JSON type TYPE "${color}" "${mode}")
            string(JSON value GET "${color}" "${mode}")
            string(LENGTH "${value}" length)
            if(NOT type STREQUAL "STRING" OR NOT length EQUAL 7 OR NOT value MATCHES "^#[0-9A-Fa-f]+$")
                message(FATAL_ERROR "Malformed color token: ${key}.${mode}")
            endif()
            set("${key}_${mode}" "${value}")
            list(APPEND reserved_identifiers "${key}_${mode}")
            string(SUBSTRING "${value}" 1 6 "hex_${mode}")
        endforeach()
        string(APPEND header "    ColorToken{\"${key}\", 0x${hex_light}u, 0x${hex_dark}u},\n")
    endforeach()
    string(APPEND header "}};\n\n")
    string(JSON sizes GET "${tokens}" size)
    string(JSON size_type TYPE "${sizes}")
    string(JSON size_count LENGTH "${sizes}")
    if(NOT size_type STREQUAL "OBJECT" OR size_count LESS 1 OR size_count GREATER 128)
        message(FATAL_ERROR "Size tokens must be a nonempty object of at most 128 entries")
    endif()
    math(EXPR last_size "${size_count} - 1")
    foreach(index RANGE ${last_size})
        string(JSON key MEMBER "${sizes}" ${index})
        string(JSON type TYPE "${sizes}" "${key}")
        string(JSON value GET "${sizes}" "${key}")
        if(NOT key MATCHES "^br_[a-z][a-z0-9_]*$" OR key MATCHES "__" OR key IN_LIST allowed_substitutions OR key IN_LIST reserved_identifiers)
            message(FATAL_ERROR "Malformed or duplicate size token name: ${key}")
        endif()
        if(NOT type STREQUAL "NUMBER" OR NOT value MATCHES "^[0-9]+$" OR value GREATER 4096)
            message(FATAL_ERROR "Size token ${key} must be an integer from 0 through 4096")
        endif()
        set("${key}" "${value}")
        list(APPEND allowed_substitutions "${key}")
        string(APPEND header "inline constexpr std::uint32_t ${key} = ${value}u;\n")
    endforeach()
    string(JSON fonts GET "${tokens}" font)
    _braurser_theme_object("${fonts}" "font" ui mono)
    foreach(key IN ITEMS ui mono)
        string(JSON type TYPE "${fonts}" "${key}")
        string(JSON value GET "${fonts}" "${key}")
        string(LENGTH "${value}" length)
        if(NOT type STREQUAL "STRING" OR length GREATER 128 OR NOT value MATCHES "^[A-Za-z][A-Za-z0-9 _-]*$")
            message(FATAL_ERROR "Malformed font token: ${key}")
        endif()
        if("br_font_${key}" IN_LIST allowed_substitutions)
            message(FATAL_ERROR "Duplicate font token: ${key}")
        endif()
        set("br_font_${key}" "${value}")
        list(APPEND allowed_substitutions "br_font_${key}")
        string(APPEND header "inline constexpr std::string_view br_font_${key} = \"${value}\";\n")
    endforeach()
    string(JSON motion GET "${tokens}" motion)
    _braurser_theme_object("${motion}" "motion" hover_ms disclosure_ms)
    foreach(key IN ITEMS hover_ms disclosure_ms)
        string(JSON type TYPE "${motion}" "${key}")
        string(JSON value GET "${motion}" "${key}")
        if(NOT type STREQUAL "NUMBER" OR NOT value MATCHES "^[0-9]+$" OR value GREATER 10000)
            message(FATAL_ERROR "Motion token ${key} must be an integer from 0 through 10000")
        endif()
        if("br_${key}" IN_LIST allowed_substitutions)
            message(FATAL_ERROR "Duplicate motion token: ${key}")
        endif()
        set("br_${key}" "${value}")
        list(APPEND allowed_substitutions "br_${key}")
        string(APPEND header "inline constexpr std::uint32_t br_${key} = ${value}u;\n")
    endforeach()
    string(APPEND header "\n}\n")
    foreach(key IN ITEMS br_space_2 br_space_3 br_border_width br_focus_width br_indicator_size br_switch_width)
        if(NOT key IN_LIST allowed_substitutions)
            message(FATAL_ERROR "Missing geometry token: ${key}")
        endif()
    endforeach()
    math(EXPR br_emphasis_padding_y "${br_space_2} + ${br_border_width} - ${br_focus_width}")
    math(EXPR br_emphasis_padding_x "${br_space_3} + ${br_border_width} - ${br_focus_width}")
    math(EXPR br_indicator_mark_border "${br_border_width} + ${br_space_2} / 2")
    math(EXPR br_indicator_mark_size "${br_indicator_size} + 2 * ${br_border_width} - 2 * ${br_indicator_mark_border}")
    math(EXPR br_switch_thumb_offset "${br_switch_width} - ${br_indicator_size} + ${br_border_width}")
    foreach(key IN ITEMS br_emphasis_padding_y br_emphasis_padding_x br_indicator_mark_border br_indicator_mark_size br_switch_thumb_offset)
        if(${key} LESS 0 OR key IN_LIST allowed_substitutions)
            message(FATAL_ERROR "Invalid derived theme geometry: ${key}")
        endif()
        list(APPEND allowed_substitutions "${key}")
    endforeach()
    _braurser_theme_read("${data_dir}/theme/gtk.css.in" gtk_template)
    _braurser_theme_read("${data_dir}/theme/qt.qss.in" qt_template)
    string(REGEX MATCHALL "@[A-Za-z_][A-Za-z0-9_]*" references "${gtk_template}")
    foreach(reference IN LISTS references)
        string(SUBSTRING "${reference}" 1 -1 key)
        if(NOT key IN_LIST colors)
            message(FATAL_ERROR "Unknown GTK color reference: ${reference}")
        endif()
    endforeach()
    if("${qt_template}" MATCHES "@[A-Za-z_][A-Za-z0-9_]*")
        message(FATAL_ERROR "QSS must not contain GTK color references")
    endif()
    foreach(mode IN ITEMS light dark)
        set(definitions "")
        foreach(key IN LISTS colors)
            set("${key}" "${${key}_${mode}}")
            string(APPEND definitions "@define-color ${key} ${${key}};\n")
        endforeach()
        _braurser_theme_render("${gtk_template}" gtk_body)
        _braurser_theme_render("${qt_template}" qt_body)
        set("gtk_${mode}" "${definitions}\n${gtk_body}")
        set("qt_${mode}" "${qt_body}")
    endforeach()
    get_filename_component(output_dir "${arg_OUTPUT_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    file(MAKE_DIRECTORY "${output_dir}")
    foreach(mode IN ITEMS light dark)
        file(WRITE "${output_dir}/braurser-${mode}.css" "${gtk_${mode}}")
        file(WRITE "${output_dir}/braurser-${mode}.qss" "${qt_${mode}}")
    endforeach()
    file(WRITE "${output_dir}/theme_tokens.hpp" "${header}")
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${data_dir}/tokens.json" "${data_dir}/theme/gtk.css.in" "${data_dir}/theme/qt.qss.in")
    endif()
endfunction()

function(braurser_rasterize_icons)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "OUTPUT_DIR" "")
    if(NOT arg_OUTPUT_DIR OR arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "braurser_rasterize_icons requires OUTPUT_DIR <dir>")
    endif()
    find_program(BRAURSER_RSVG_CONVERT NAMES rsvg-convert)
    if(NOT BRAURSER_RSVG_CONVERT)
        message(STATUS "rsvg-convert not found; PNG icon generation is unavailable")
        return()
    endif()
    if(CMAKE_SCRIPT_MODE_FILE)
        message(FATAL_ERROR "braurser_rasterize_icons requires project configure mode")
    endif()
    get_filename_component(output_dir "${arg_OUTPUT_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    set(source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../data/icons/braurser.svg")
    set(outputs "")
    foreach(size IN ITEMS 16 24 32 48 64 128 256)
        set(directory "${output_dir}/hicolor/${size}x${size}/apps")
        set(output "${directory}/braurser.png")
        add_custom_command(OUTPUT "${output}"
            COMMAND "${CMAKE_COMMAND}" -E make_directory "${directory}"
            COMMAND "${BRAURSER_RSVG_CONVERT}" -w "${size}" -h "${size}" "${source}" -o "${output}"
            DEPENDS "${source}"
            VERBATIM)
        list(APPEND outputs "${output}")
    endforeach()
    add_custom_target(braurser_icons DEPENDS ${outputs})
endfunction()
