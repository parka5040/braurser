cmake_minimum_required(VERSION 3.25)

set(icon_dir "${CMAKE_CURRENT_LIST_DIR}/../../data/icons")
set(required
    braurser braurser-symbolic braurser-package-symbolic braurser-official-symbolic braurser-community-symbolic
    braurser-git-symbolic braurser-outside-symbolic braurser-restart-symbolic braurser-logout-symbolic braurser-app-restart-symbolic
    braurser-updates-symbolic braurser-wiki-symbolic braurser-search-symbolic braurser-filter-symbolic braurser-back-symbolic
    braurser-settings-symbolic braurser-activity-symbolic braurser-installed-symbolic braurser-discover-symbolic braurser-lock-symbolic
    braurser-info-symbolic braurser-warning-symbolic braurser-error-symbolic braurser-success-symbolic braurser-chevron-down-symbolic
    braurser-chevron-right-symbolic braurser-close-symbolic braurser-external-link-symbolic braurser-copy-symbolic braurser-offline-symbolic)
foreach(name IN LISTS required)
    if(NOT EXISTS "${icon_dir}/${name}.svg")
        message(FATAL_ERROR "Missing required SVG: ${name}")
    endif()
endforeach()
file(GLOB icons "${icon_dir}/*.svg")
foreach(icon IN LISTS icons)
    file(SIZE "${icon}" length)
    if(length GREATER 65536 OR length EQUAL 0)
        message(FATAL_ERROR "SVG must contain at most 64 KiB: ${icon}")
    endif()
    file(READ "${icon}" svg)
    string(TOLOWER "${svg}" lower)
    foreach(forbidden IN ITEMS "<script" "<style" "href=\"http" "<!--" "<image" "data:" "<!" "<?" "url(")
        string(FIND "${lower}" "${forbidden}" position)
        if(NOT position EQUAL -1)
            message(FATAL_ERROR "Forbidden SVG content ${forbidden} in ${icon}")
        endif()
    endforeach()
    if(lower MATCHES "[ \t\r\n](href|xlink:href|on[a-z]+)[ \t\r\n]*=")
        message(FATAL_ERROR "External references or event handlers in ${icon}")
    endif()
    string(REGEX MATCHALL "</?[a-zA-Z_:][a-zA-Z0-9_:.-]*" tags "${svg}")
    foreach(tag IN LISTS tags)
        string(REGEX REPLACE "^</?" "" element "${tag}")
        if(NOT element MATCHES "^(svg|g|path|rect|circle)$")
            message(FATAL_ERROR "Unsupported SVG element ${element} in ${icon}")
        endif()
    endforeach()
    if(icon MATCHES "-symbolic\\.svg$")
        foreach(attribute IN ITEMS "viewBox=\"0 0 24 24\"" "stroke=\"currentColor\"" "stroke-width=\"2\"" "stroke-linecap=\"round\"" "stroke-linejoin=\"round\"" "fill=\"none\"")
            string(FIND "${svg}" "${attribute}" position)
            if(position EQUAL -1)
                message(FATAL_ERROR "Missing symbolic SVG attribute ${attribute} in ${icon}")
            endif()
        endforeach()
        string(REGEX MATCHALL "(fill|stroke)[ \t\r\n]*=[ \t\r\n]*[\"'][^\"']*[\"']" paints "${svg}")
        foreach(paint IN LISTS paints)
            if(NOT paint STREQUAL "fill=\"none\"" AND NOT paint STREQUAL "stroke=\"currentColor\"")
                message(FATAL_ERROR "Fixed symbolic SVG paint ${paint} in ${icon}")
            endif()
        endforeach()
    endif()
endforeach()
list(LENGTH icons count)
message(STATUS "Theme.SvgSafe: ${count} safe SVG masters verified")
