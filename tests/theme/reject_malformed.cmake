cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED OUT OR OUT STREQUAL "")
    message(FATAL_ERROR "OUT must name the malformed-theme fixture directory")
endif()
set(root "${CMAKE_CURRENT_LIST_DIR}/../..")
file(READ "${root}/data/tokens.json" original_tokens)
file(READ "${root}/data/theme/gtk.css.in" original_gtk)
file(READ "${root}/data/theme/qt.qss.in" original_qt)

function(expect_rejected name tokens gtk qt expected)
    set(fixture "${OUT}/${name}")
    file(MAKE_DIRECTORY "${fixture}/cmake" "${fixture}/data/theme")
    file(COPY "${root}/cmake/Theme.cmake" DESTINATION "${fixture}/cmake")
    file(WRITE "${fixture}/data/tokens.json" "${tokens}")
    file(WRITE "${fixture}/data/theme/gtk.css.in" "${gtk}")
    file(WRITE "${fixture}/data/theme/qt.qss.in" "${qt}")
    file(WRITE "${fixture}/run.cmake"
        "cmake_minimum_required(VERSION 3.25)\ninclude(\"${fixture}/cmake/Theme.cmake\")\nbraurser_generate_theme(OUTPUT_DIR \"${fixture}/generated\")\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${fixture}/run.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "${name} was not rejected as expected: ${result}\n${output}${error}")
    endif()
    message(STATUS "Rejected ${name}")
endfunction()

string(JSON changed SET "${original_tokens}" version 2)
expect_rejected(version "${changed}" "${original_gtk}" "${original_qt}" "Unsupported theme token version")
string(JSON changed REMOVE "${original_tokens}" color br_bg)
expect_rejected(missing-color "${changed}" "${original_gtk}" "${original_qt}" "unexpected or missing keys")
string(JSON changed SET "${original_tokens}" color br_bg light "\"#GGGGGG\"")
expect_rejected(color "${changed}" "${original_gtk}" "${original_qt}" "Malformed color token")
string(JSON changed SET "${original_tokens}" color br_bg extra "\"#FFFFFF\"")
expect_rejected(extra-mode "${changed}" "${original_gtk}" "${original_qt}" "unexpected or missing keys")
string(JSON changed SET "${original_tokens}" size br_body_font_size "\"15\"")
expect_rejected(size-type "${changed}" "${original_gtk}" "${original_qt}" "must be an integer")
string(JSON changed SET "${original_tokens}" size br_body_font_size -1)
expect_rejected(negative-size "${changed}" "${original_gtk}" "${original_qt}" "must be an integer")
string(JSON changed SET "${original_tokens}" size br_body_font_size 4097)
expect_rejected(oversized-size "${changed}" "${original_gtk}" "${original_qt}" "must be an integer")
string(JSON changed SET "${original_tokens}" size br_bg_light 1)
expect_rejected(reserved-size "${changed}" "${original_gtk}" "${original_qt}" "Malformed or duplicate size token name")
string(JSON changed SET "${original_tokens}" size br_bad__identifier 1)
expect_rejected(reserved-cpp-identifier "${changed}" "${original_gtk}" "${original_qt}" "Malformed or duplicate size token name")
string(JSON changed SET "${original_tokens}" font ui "\"Bad;Font\"")
expect_rejected(font "${changed}" "${original_gtk}" "${original_qt}" "Malformed font token")
string(JSON changed SET "${original_tokens}" motion hover_ms 10001)
expect_rejected(motion "${changed}" "${original_gtk}" "${original_qt}" "must be an integer")
expect_rejected(qss-placeholder "${original_tokens}" "${original_gtk}" "${original_qt}\nQLabel { color: \${br_unknown}; }\n" "Unknown theme placeholder")
expect_rejected(gtk-reference "${original_tokens}" "${original_gtk}\n.braurser { color: @br_unknown; }\n" "${original_qt}" "Unknown GTK color reference")
expect_rejected(dangling-placeholder "${original_tokens}" "${original_gtk}" "${original_qt}\n\${br_bg" "Unresolved theme placeholder")
expect_rejected(at-placeholder "${original_tokens}" "${original_gtk}" "${original_qt}\n@unknown@" "QSS must not contain GTK color references")
message(STATUS "Theme.RejectMalformed: 15 invalid inputs rejected")
