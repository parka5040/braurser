cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED OUT OR OUT STREQUAL "")
    message(FATAL_ERROR "OUT must name the generated theme directory")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/Theme.cmake")
braurser_generate_theme(OUTPUT_DIR "${OUT}")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../../data/tokens.json" tokens)
string(JSON colors GET "${tokens}" color)
string(JSON color_count LENGTH "${colors}")
math(EXPR last_color "${color_count} - 1")
foreach(mode IN ITEMS light dark)
    foreach(extension IN ITEMS css qss)
        set(path "${OUT}/braurser-${mode}.${extension}")
        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "Missing generated theme: ${path}")
        endif()
        file(READ "${path}" body)
        if(body STREQUAL "" OR body MATCHES "\\$\\{|@[A-Za-z_][A-Za-z0-9_]*@")
            message(FATAL_ERROR "Empty theme or unresolved placeholder in ${path}")
        endif()
        if(extension STREQUAL "qss" AND body MATCHES "@br_")
            message(FATAL_ERROR "GTK color reference leaked into ${path}")
        endif()
        if(extension STREQUAL "css")
            set(allowed_colors "")
            foreach(index RANGE ${last_color})
                string(JSON key MEMBER "${colors}" ${index})
                string(JSON value GET "${colors}" "${key}" "${mode}")
                string(FIND "${body}" "@define-color ${key} ${value};" definition)
                if(definition EQUAL -1)
                    message(FATAL_ERROR "Missing or incorrect ${mode} definition for ${key}")
                endif()
                list(APPEND allowed_colors "@${key}")
            endforeach()
            string(REGEX MATCHALL "@br_[A-Za-z0-9_]+" references "${body}")
            foreach(reference IN LISTS references)
                if(NOT reference IN_LIST allowed_colors)
                    message(FATAL_ERROR "Undefined GTK reference: ${reference}")
                endif()
            endforeach()
        endif()
    endforeach()
endforeach()
if(NOT EXISTS "${OUT}/theme_tokens.hpp")
    message(FATAL_ERROR "Missing generated C++ header")
endif()
file(READ "${OUT}/theme_tokens.hpp" header)
if(header STREQUAL "" OR header MATCHES "\\$\\{|@br_|//|/\\*")
    message(FATAL_ERROR "Generated header has comments or unresolved placeholders")
endif()
foreach(index RANGE ${last_color})
    string(JSON key MEMBER "${colors}" ${index})
    foreach(mode IN ITEMS light dark)
        string(JSON value GET "${colors}" "${key}" "${mode}")
        string(SUBSTRING "${value}" 1 6 "hex_${mode}")
    endforeach()
    string(FIND "${header}" "ColorToken{\"${key}\", 0x${hex_light}u, 0x${hex_dark}u}" entry)
    if(entry EQUAL -1)
        message(FATAL_ERROR "Generated header differs from tokens for ${key}")
    endif()
endforeach()
message(STATUS "Theme.Generate: verified both CSS/QSS palettes and ${color_count} C++ color tokens")
